# The module's settings: every variable the kit's backend reads. Copy to .env and edit.
# For docker compose against the stub Eneo these values work as they are.

# Where the module reaches Eneo from the server (inside the compose network the stub is "stub-eneo"), and where the
# browser reaches Eneo (what the login redirects to). In production both are Eneo's.
ENEO_BACKEND_URL=http://stub-eneo:8411
ENEO_PUBLIC_URL=http://localhost:8411
# This module's own public address: the login's callback is MODULE_PUBLIC_URL/api/auth/callback, which is registered in
# Eneo's admin together with the module key.
MODULE_PUBLIC_URL=http://localhost:3001
# The module key registered in Eneo (lowercase kebab-case) and the module's service key.
MODULE_KEY=eneo-module
ENEO_API_KEY=stub-service-key
# At least 32 characters; signs the login's state cookie. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-to-at-least-32-random-characters
# false only over plain http (local development); production is https.
COOKIE_SECURE=false

# Optional.
# ENEO_API_KEY_HEADER_NAME=X-API-Key
# SESSION_MAX_AGE_MINUTES=480
# The organisation beside the module's name in the top bar: a name, and optionally a logo (SVG or PNG, at most 1 MiB)
# for each colour mode. SHOW_ORGANIZATION=false shows the module's name alone.
# ORGANIZATION_NAME=Exempelkommunen
# ORGANIZATION_LOGO=/run/secrets/logo.svg
# ORGANIZATION_LOGO_DARK=/run/secrets/logo-dark.svg
# SHOW_ORGANIZATION=true
# The accent is independent of the name/logo; the backend checks contrast and derives dark mode if omitted.
# ORGANIZATION_ACCENT='#1E7B34'
# ORGANIZATION_ACCENT_DARK='#2AAE4A'
# MAX_BODY_BYTES=10485760
# MAX_UPLOAD_BYTES=1073741824
# MAX_RESPONSE_BYTES=33554432
# MAX_CONCURRENT_STREAMS=64
# MAX_CONCURRENT_UPLOADS=1
# MAX_CONCURRENT_HEAVY_IO=64
# UPLOAD_PROXY_TIMEOUT_SECONDS=1800
# UPLOAD_RECEIVE_TIMEOUT_SECONDS=1800
# UPLOAD_RECEIVE_IDLE_TIMEOUT_SECONDS=30
